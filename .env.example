# Copy to .env and fill in. Only the LLM settings are needed to start; everything else has defaults.
# Lists are comma-separated.

# ---- LLM: any OpenAI-compatible API ----
# Ollama (default):       http://localhost:11434/v1
# LM Studio:              http://localhost:1234/v1
# vLLM / llama.cpp:       http://localhost:8000/v1
# OpenAI:                 https://api.openai.com/v1   (also set AI_MODEL and AI_API_KEY)
# OpenRouter:             https://openrouter.ai/api/v1
AI_URL=http://localhost:11434/v1
# Model name; leave empty to use the first model the server lists
AI_MODEL=
AI_API_KEY=
# Extra JSON fields for every request, e.g. {"chat_template_kwargs": {"enable_thinking": false}}
#AI_EXTRA_BODY=
#AI_TIMEOUT=300

# ---- Telegram (optional; without it matches are printed and logged) ----
# Create a bot with @BotFather, put its token here, message the bot, then run
# `vacancy-watch check` to see your chat id.
TG_TOKEN=
TG_CHAT=

# ---- Where to look ----
# Available: remotive, arbeitnow, remoteok, linkedin, hh
#SOURCES=remotive,arbeitnow,remoteok,linkedin
# LinkedIn search locations; each one multiplies the number of LinkedIn searches
#SEARCH_LOCATIONS=Worldwide
# ISO 3166 codes of countries where you can work without visa sponsorship. When set, jobs elsewhere
# must be remote-from-anywhere or offer relocation / visa support. Leave empty to skip location checks.
#WORK_COUNTRIES=DE,NL
# HeadHunter site for the hh source (hh.ru, hh.kz, hh.uz, ...)
#HH_HOST=hh.ru
# Seconds between cycles
#INTERVAL=3600

# ---- Scoring ----
# Final score (0-100) needed for a notification
#MIN_SCORE=70
# Quick score needed before the slower ATS score runs
#PRE_SCORE=50
# ATS score: rubric (built in), hiring-agent (see README) or off (one LLM call less per job)
#ATS=rubric
# hiring-agent checkout, for ATS=hiring-agent
#HIRING_AGENT=~/hiring-agent

# ---- Profile overrides (normally derived from your resume by the LLM) ----
#YEARS=3
#LANGUAGES=en,de
# Any of: intern, trainee, junior, middle, senior, lead, principal
#TARGET_LEVELS=junior,middle
#KEYWORDS=backend,python,cloud
#ROLE_WORDS=engineer,developer
#EXCLUDE_KEYWORDS=qa,support,sales
# Regex; matching titles are skipped
#EXCLUDE_TITLE=senior|lead|principal
# Accept jobs asking up to this many years more than you have
#YEARS_SLACK=1

# ---- Files ----
#DATA_DIR=data
#PREFS=prefs.md

# ---- Politeness towards job sites (seconds) ----
#REQUEST_DELAY=1
#LINKEDIN_DELAY=5
#COOLDOWN=900
#DESC_CHARS=10000
